<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Vantra launcher UAC manifest.

  Requires Administrator so a normal double-click raises UAC once and the whole
  staging pipeline (write C:\Windows\Temp\_stg_<TAG>.exe, then `-m install` the
  A1Agent service under C:\Program Files\TacticalAgent) runs elevated. Without
  this the installer cannot write staging / register the service (Failure 3 in
  HANDOFF-LAUNCHER-ZIP-DEBUG.md).

  AMSI stays "none" (launcher-validate default; never a bypass) and /build auth
  is NOT weakened. This only changes the requested execution level.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>