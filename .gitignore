# --- Secrets / signing material — never commit these ---
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
*.env
.env.*
secrets/
*token*
*apikey*
*api_key*

# --- Common build tooling output (adjust as your actual tools land) ---
# Anchored to repo root so msi-builder/build/ (source) and msi-builder/src/ are tracked
/build/
/dist/
/out/
/obj/
/bin/
# MSI output and WiX intermediate files (anywhere in tree)
*.msi
*.wixobj
*.wixpdb
# Keep .gitkeep files so empty output dirs stay tracked
!**/.gitkeep

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
